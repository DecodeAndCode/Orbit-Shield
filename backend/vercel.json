{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": null,
  "functions": {
    "api/index.py": {
      "runtime": "@vercel/python@5.0.0",
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "src/data/**"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
